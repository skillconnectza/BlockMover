<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- ── Step 1 ── -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Step 1 — Become default dialer"
            android:textStyle="bold" android:textSize="16sp" android:layout_marginBottom="6dp"/>
        <TextView android:id="@+id/stepDialerStatus"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="⬜ Not yet set" android:layout_marginBottom="4dp"/>

        <!-- Restricted-settings hint (Android 13+) -->
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="⚠️ On Android 13+, if the button below has no effect:\nSettings → Apps → BlockMover → ⋮ (More) → Allow restricted settings → then try again."
            android:textSize="12sp"
            android:background="#FFF3CD"
            android:padding="8dp"
            android:layout_marginBottom="8dp"/>

        <Button android:id="@+id/btnRequestDialer"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Set as Default Dialer" android:layout_marginBottom="28dp"/>

        <!-- ── Step 2 ── -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Step 2 — Read your blocked numbers"
            android:textStyle="bold" android:textSize="16sp" android:layout_marginBottom="6dp"/>
        <TextView android:id="@+id/tvCount"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:visibility="gone" android:layout_marginBottom="8dp"/>
        <Button android:id="@+id/btnReadNumbers"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Read Blocked Numbers" android:enabled="false"
            android:layout_marginBottom="28dp"/>

        <!-- ── Step 3 ── -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Step 3 — Export &amp; share the file"
            android:textStyle="bold" android:textSize="16sp" android:layout_marginBottom="6dp"/>
        <Button android:id="@+id/btnExport"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Export Blocklist" android:enabled="false"
            android:layout_marginBottom="12dp"/>

        <!-- Transfer method examples -->
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="💡 How to get the file to your other phone:"
            android:textStyle="bold" android:textSize="13sp"
            android:layout_marginBottom="4dp"/>
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="• WhatsApp / Telegram — send it to yourself or a saved contact\n• Google Drive / Dropbox — upload and open on the other phone\n• Gmail / Outlook — email it to yourself\n• Bluetooth — pair both phones and send the file\n• USB cable — copy to PC, then to the other phone"
            android:textSize="13sp"
            android:background="#E8F4FD"
            android:padding="10dp"
            android:layout_marginBottom="28dp"/>

        <!-- ── Step 4 ── -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Step 4 — Restore your real phone app"
            android:textStyle="bold" android:textSize="16sp" android:layout_marginBottom="6dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Settings → Default Apps → Phone → pick your original app."
            android:layout_marginBottom="8dp"/>
        <Button android:id="@+id/btnRestoreDialer"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Open Default Apps Settings"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_marginBottom="28dp"/>

        <!-- ── Reset ── -->
        <Button android:id="@+id/btnReset"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="↺  Start Over"
            style="@style/Widget.Material3.Button.TextButton"/>

    </LinearLayout>
</ScrollView>
